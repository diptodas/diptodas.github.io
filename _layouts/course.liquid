---
layout: page
---
<div class="course">
  {% if page.course_code or page.institution or page.term or page.sections or page.location or page.time %}
    <div class="course-info">
      {% if page.course_code %}
        <p><strong>Course:</strong> {{ page.course_code }}</p>
      {% endif %}

      {% if page.institution %}
        <p><strong>Institution:</strong> {{ page.institution }}</p>
      {% endif %}

      {% if page.term %}
        <p><strong>Taught:</strong> {{ page.term }}</p>
      {% endif %}

      {% if page.sections %}
        <p><strong>Enrollment:</strong> {{ page.sections }}</p>
      {% endif %}

      {% if page.location %}
        <p><strong>Location:</strong> {{ page.location }}</p>
      {% endif %}

      {% if page.time %}
        <p><strong>Time:</strong> {{ page.time }}</p>
      {% endif %}
    </div>
  {% endif %}

  {{ content }}

  {% if page.schedule %}
    {% assign dated_entries = page.schedule | where_exp: 'entry', 'entry.date' %}
    {% assign material_entries = page.schedule | where_exp: 'entry', 'entry.materials' %}
    <h2>Schedule</h2>
    {% if page.schedule_note %}
      <p class="schedule-note">{{ page.schedule_note }}</p>
    {% endif %}
    <table class="table table-sm table-responsive">
      <thead>
        <tr>
          <th>{{ page.schedule_unit | default: 'Week' }}</th>
          {% if dated_entries.size > 0 %}<th>Date</th>{% endif %}
          <th>Topic</th>
          {% if material_entries.size > 0 %}<th>Readings and materials</th>{% endif %}
        </tr>
      </thead>
      <tbody>
        {% for entry in page.schedule %}
          <tr>
            <td>{{ entry.week }}</td>
            {% if dated_entries.size > 0 %}<td>{{ entry.date }}</td>{% endif %}
            <td>
              {% if entry.topic %}
                <strong>{{ entry.topic }}</strong>
              {% endif %}
              {% if entry.description %}
                <div class="schedule-description">{{ entry.description | markdownify }}</div>
              {% endif %}
            </td>
            {% if material_entries.size > 0 %}
              <td>
                {% if entry.materials %}
                  <ul class="schedule-materials">
                    {% for material in entry.materials %}
                      <li>
                        {% if material.url %}
                          {% if material.url contains '://' %}
                            <a href="{{ material.url }}" target="_blank">{{ material.name }}</a>
                          {% else %}
                            <a href="{{ material.url | relative_url }}" target="_blank">{{ material.name }}</a>
                          {% endif %}
                        {% else %}
                          {{ material.name }}
                        {% endif %}
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </td>
            {% endif %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}
</div>
